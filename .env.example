# Optional integrations.
# Copy to .env and fill in real values per deployment.
# Never commit .env.

# Form delivery (Formspree, Web3Forms, or your own webhook).
PUBLIC_FORM_ENDPOINT=

# Cloudflare Turnstile site key (public, safe to expose).
PUBLIC_TURNSTILE_SITE_KEY=

# Transactional email: nothing to set. This template ships static-only and
# sends no email. If a site needs it (enquiry notices, confirmations,
# password resets), add a serverless function and send through an account
# in the client's own name: Scaleway Transactional Email (France) or
# Lettermint (the Netherlands). Never an agency-shared account, and never
# anything promotional in a transactional email. README, "Transactional email".

# Stripe publishable key (public, safe to expose).
PUBLIC_STRIPE_PUBLISHABLE_KEY=
